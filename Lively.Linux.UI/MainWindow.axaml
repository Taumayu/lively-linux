<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Lively.Models.Gallery.API;assembly=Lively.Models"
        xmlns:localModels="clr-namespace:Lively.Models;assembly=Lively.Models"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        x:Class="Lively.Linux.UI.MainWindow"
        Title="Lively Wallpaper Linux" Width="1000" Height="700"
        Background="#1E1E1E">
    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15">
            <TextBlock Text="Lively Library" Foreground="White" FontSize="20" FontWeight="Bold"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 350" Margin="20">
            <!-- Left Side: Tabs for Local and Gallery -->
            <TabControl Grid.Column="0">
                <TabItem Header="Local Library">
                    <ListBox x:Name="LocalWallpapersListBox" Background="Transparent" SelectionChanged="LocalWallpapersListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="localModels:LivelyInfoModel">
                                <Border Background="#333" CornerRadius="8" Margin="5" Width="220" Height="300" ClipToBounds="True">
                                    <Grid RowDefinitions="150, *">
                                        <!-- Thumbnail Image -->
                                        <Image Grid.Row="0" asyncImageLoader:ImageLoader.Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        
                                        <!-- Content Details -->
                                        <StackPanel Grid.Row="1" Spacing="5" Margin="10">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Author}" Foreground="Gray" FontSize="12" />
                                            <TextBlock Text="{Binding Desc}" Foreground="LightGray" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Type}" Foreground="#007ACC" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                
                <TabItem Header="Gallery (Online)">
                    <ListBox x:Name="WallpapersListBox" Background="Transparent" SelectionChanged="WallpapersListBox_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WallpaperDto">
                                <Border Background="#333" CornerRadius="8" Margin="5" Width="220" Height="300" ClipToBounds="True">
                                    <Grid RowDefinitions="150, *">
                                        <Image Grid.Row="0" asyncImageLoader:ImageLoader.Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        
                                        <StackPanel Grid.Row="1" Spacing="5" Margin="10">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Author.DisplayName}" Foreground="Gray" FontSize="12" />
                                            <TextBlock Text="{Binding Description}" Foreground="LightGray" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Type}" Foreground="#007ACC" FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- Right Side: Sidebar -->
            <StackPanel Grid.Column="1" Spacing="20" Margin="20,0,0,0">
                <TextBlock Text="Set Wallpaper" Foreground="White" FontSize="18" FontWeight="Bold"/>
                
                <TextBlock Text="Select Display:" Foreground="LightGray" FontSize="14"/>
                <ComboBox x:Name="DisplayComboBox" Background="#333" Foreground="White" SelectedIndex="0" HorizontalAlignment="Stretch">
                </ComboBox>

                <TextBlock Text="Selected Path / ID:" Foreground="LightGray" FontSize="14"/>
                <TextBox x:Name="WallpaperPathTextBox" PlaceholderText="Select a wallpaper..." Background="#333" Foreground="White" Padding="10"/>
                
                <Button x:Name="DownloadWallpaperButton" Content="Download (Online Gallery)" Background="#28A745" Foreground="White" Padding="15,10" HorizontalAlignment="Stretch" Click="DownloadWallpaperButton_Click"/>
                <Button x:Name="SetWallpaperButton" Content="Set Wallpaper (Send gRPC)" Background="#007ACC" Foreground="White" Padding="15,10" HorizontalAlignment="Stretch" Click="SetWallpaperButton_Click"/>
                <Button x:Name="CloseWallpaperButton" Content="Close Wallpaper" Background="#DC3545" Foreground="White" Padding="15,10" HorizontalAlignment="Stretch" Click="CloseWallpaperButton_Click"/>
                <Button x:Name="AutostartButton" Content="Toggle Autostart" Background="#444" Foreground="White" Padding="15,10" HorizontalAlignment="Stretch" Click="AutostartButton_Click"/>
                
                <TextBlock x:Name="StatusTextBlock" Text="Status: Loading..." Foreground="LightGreen" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
